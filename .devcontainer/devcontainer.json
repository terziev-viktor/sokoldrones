{
    "name": "SokolDrones Development Container",
    "privileged": true,
    "remoteUser": "vterziev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "USERNAME": "vterziev",
            "ROS_DISTRO": "jazzy",
            "PX4_VERSION": "v1.15.4"
        }
    },
    "workspaceFolder": "/home/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "QT_X11_NO_MITSHM": "1",
        "QT_QPA_PLATFORM": "xcb",
        "CCACHE_DIR": "/home/ws/.ccache",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--net=host",
        "--pid=host",
        "--ipc=host",
        "--device=/dev/dri",
        "--group-add=video"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    "initializeCommand": "xhost +local: || true",
    "postStartCommand": "sudo chmod a+rw /dev/dri/* || true",
    "postCreateCommand": "git config --global --add safe.directory '*' && sudo rosdep update && sudo rosdep install --from-paths src --ignore-src -y --skip-keys='px4_msgs' ; sudo chown -R $(whoami) /home/ws/"
}